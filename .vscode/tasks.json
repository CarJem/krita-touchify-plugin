{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install Plugin",
            "type": "shell",
            "linux": {
                "command": "./build_scripts/dev-flatpak-install.sh"
            },
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true
            }
        },
        {
            "label": "Update Configs",
            "type": "shell",
            "linux": {
                "command": "./build_scripts/dev-flatpak-update-config.sh"
            },
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true
            }
        },
        {
            "label": "Launch Krita.COM",
            "hide": true,
            "type": "shell",
            "linux": {
                "command": "/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=krita --file-forwarding org.kde.krita"
            }
        },
        {
            "label": "Close Krita.COM",
            "hide": true,
            "type": "shell",
            "linux": {
                "command": "/usr/bin/flatpak kill org.kde.krita || echo 'Krita was not running'"
            },
            "presentation": {
                "close": true
            }
        },
        {
            "label": "Plugin Prelaunch",
            "hide": true,
            "dependsOn": [
                "Close Krita.COM",
                "Install Plugin"
            ]
        },
        {
            "label": "……………………………………………",
            "type": "shell",
            "command": "",
            "hide": true
        }
    ]
}