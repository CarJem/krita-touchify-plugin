{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Plugin",
            "type": "shell",
            "linux": {
                "command": "./build_scripts/run-plugin.sh"
            },
        },
        {
            "label": "Run Plugin (Debug)",
            "type": "shell",
            "linux": {
                "command": "./build_scripts/run-plugin-debug.sh"
            },
        },
        {
            "label": "Install Plugin",
            "type": "shell",
            "linux": {
                "command": "./build_scripts/install-plugin.sh"
            },
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true
            }
        },
        {
            "label": "Update Configs",
            "type": "shell",
            "linux": {
                "command": "./build_scripts/update-configs.sh"
            },
            "presentation": {
                "reveal": "silent",
                "revealProblems": "onProblem",
                "close": true
            }
        },
        {
            "label": "Launch Krita.COM",
            "hide": true,
            "type": "shell",
            "linux": {
                "command": "./build_scripts/launch-krita.sh"
            }
        },
        {
            "label": "Close Krita.COM",
            "hide": true,
            "type": "shell",
            "linux": {
                "command": "./build_scripts/close-krita.sh"
            },
            "presentation": {
                "close": true
            }
        },
        {
            "label": "Plugin Prelaunch",
            "hide": true,
            "dependsOn": [
                "Close Krita.COM",
                "Install Plugin"
            ]
        },
        {
            "label": "……………………………………………",
            "type": "shell",
            "command": "",
            "hide": true
        }
    ]
}