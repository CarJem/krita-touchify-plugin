#KRITA_PATH="$HOME/.local/share/krita/pykrita"
#START_COMMAND="/home/carjem/Applications/appimages/krita-5.3.0-prealpha-8d59f1c9c3-x86_64.AppImage"
#START_DEBUG_COMMAND=""
