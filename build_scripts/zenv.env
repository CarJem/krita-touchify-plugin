SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
ROOT_DIR=$( dirname "$SCRIPT_DIR" )
TOUCHIFY_PLUGIN_NAME="touchify"


# For Flatpak Development
KRITA_PATH="$HOME/.var/app/org.kde.krita/data/krita/pykrita"
START_COMMAND="/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=krita --file-forwarding org.kde.krita"
START_DEBUG_COMMAND="flatpak run --devel --command=sh org.kde.krita -c 'gdb /app/bin/krita'"
EXIT_COMMAND="/usr/bin/flatpak kill org.kde.krita"

